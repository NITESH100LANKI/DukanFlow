# ==============================================================================
# DukaanFlow — Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.
# NEVER commit .env to version control!
# ==============================================================================

# Application Settings
APP_NAME=DukaanFlow
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
# Local Docker: postgresql://dukaanflow:dukaanflow@localhost:5432/dukaanflow
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# JWT Authentication
JWT_SECRET_KEY=<GENERATE_A_SECURE_RANDOM_SECRET_KEY>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Configuration
# Set COOKIE_SECURE=false for local HTTP development; true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Google Gemini API
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=10

# Retailer Demo Mode
# If true, fixed OTP (123456) is accepted for testing without an SMS gateway
DEMO_MODE=true
DEMO_OTP=123456

# Frontend API URL (for Vite dev server proxy or production)
VITE_API_BASE_URL=http://localhost:8000/api/v1

