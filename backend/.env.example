# ==============================================================================
# DukaanFlow Backend — Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.
# NEVER commit .env to version control!
# ==============================================================================

# Application Settings
APP_NAME=DukaanFlow
APP_VERSION=0.2.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL 15 Container)
DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_USER=dukaanflow
DB_PASSWORD=dukaanflow
DB_NAME=dukaanflow
DB_HOST=localhost
DB_PORT=5432

# JWT Authentication
JWT_SECRET_KEY=<GENERATE_A_SECURE_RANDOM_SECRET_KEY>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Configuration (Local Development)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Google Gemini API
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=10

# Retailer Demo Mode (Fixed 123456 OTP)
DEMO_MODE=true
DEMO_OTP=123456

