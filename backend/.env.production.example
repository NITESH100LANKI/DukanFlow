# ==============================================================================
# DukaanFlow Backend — Production Environment Variables Template
# ==============================================================================
# COPY THIS TEMPLATE TO YOUR SECRET MANAGER / HOSTING DASHBOARD (e.g. Render Dashboard).
# NEVER COMMIT REAL PRODUCTION SECRETS OR VALUES TO VERSION CONTROL!
# ==============================================================================

# Target Environment & Debugging
ENVIRONMENT=production
DEBUG=false
APP_NAME=DukaanFlow
APP_VERSION=0.2.0
API_V1_PREFIX=/api/v1

# Production PostgreSQL Database Connection
# On Render: Injected automatically when linked to Render Managed PostgreSQL.
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL=postgresql+psycopg2://dukaanflow_user:PROD_PASSWORD_PLACEHOLDER@dpg-xxxxxx.oregon-postgres.render.com/dukaanflow?sslmode=require

# JWT Authentication Secrets
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=GENERATE_STRONG_RANDOM_SECRET_KEY_MIN_48_CHARS_BASE64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Secure Cookie Configuration
# COOKIE_SECURE MUST BE true IN PRODUCTION (requires HTTPS)
COOKIE_SECURE=true
# Use "lax" for first-party / reverse-proxy architecture (Solution A)
# Use "none" only if cross-site cookies are explicitly needed across subdomains (Solution B)
COOKIE_SAMESITE=lax
# Set to null/empty when using Vercel reverse proxy, or apex domain like .dukaanflow.in for multi-subdomain
COOKIE_DOMAIN=

# CORS Configuration
# Comma-separated list or JSON array of allowed frontend origins
CORS_ORIGINS=https://dukaanflow.vercel.app,https://dukaanflow-api.onrender.com
# Regex to match Vercel preview branch deployments
CORS_ORIGIN_REGEX=^https://.*dukaanflow.*\.vercel\.app$

# Google Gemini AI Integration
# Acquire securely from Google AI Studio / Google Cloud Console.
# Never expose this key in frontend code or client bundles!
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_USE_INTERACTIONS_API=false
AI_TIMEOUT_SECONDS=15

# Security Guardrails & SMS Gateway Integration
# DEMO_MODE MUST BE false in production! (AuthService raises HTTP 500 if true)
DEMO_MODE=false
# SMS_PROVIDER_CONFIGURED MUST BE false until a real SMS provider (Fast2SMS/Twilio/Gupshup) is wired up
SMS_PROVIDER_CONFIGURED=false
